# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Required: pooled Postgres connection string (e.g. Neon) for session/report storage.
# Run `pnpm run db:push` after setting this to create the schema.
DATABASE_URL=

# Optional: enables LLM-generated end-of-interview feedback reports.
# When unset, reports fall back to a deterministic heuristic summary.
# NEXT_LLM_API_KEY=
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions

# Optional: enables Groq-powered persona hand-off summarization and feedback
# reports (tried before NEXT_LLM_API_KEY). Falls back to the raw-transcript
# hand-off / NEXT_LLM_API_KEY / heuristic report when unset.
# GROQ_API_KEY=

# Optional: enables emailing the detailed feedback report to the recruiter
# (Gmail SMTP) after an interview ends. When unset, reports are still
# generated and shown to the candidate, just not emailed.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
